{
  "name": "launcher-pds-dir",
  "version": "0.1.0",
  "description": "An interoperable directory of AT Protocol account hosts and entryways.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./providers.json": "./data/providers.json",
    "./schema.json": "./schema.json",
    "./logos/*": "./logos/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "logos",
    "schema.json",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solimaniac/launcher-pds-dir.git"
  },
  "homepage": "https://github.com/solimaniac/launcher-pds-dir#readme",
  "bugs": "https://github.com/solimaniac/launcher-pds-dir/issues",
  "keywords": [
    "atproto",
    "at-protocol",
    "pds",
    "atmosphere",
    "launcher"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "ajv": "^8.17.1",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
