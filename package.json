{
  "name": "atmosphere-account-launcher",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write ."
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.9",
    "@atproto/oauth-types": "^0.7.7",
    "i18next": "^26.4.2",
    "launcher-components": "git+https://github.com/solimaniac/launcher-components.git#47f8814dc8695f184612d428803ed101b2e9d739",
    "pds-registry": "git+https://github.com/solimaniac/pds-registry.git#62d664c3baa5414ddbfdebbcb62c1a8074128839"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "arrowParens": "avoid",
    "trailingComma": "all"
  }
}
