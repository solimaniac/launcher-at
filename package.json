{
  "name": "launcher-components",
  "version": "0.1.0",
  "description": "Unstyled, framework-independent AT Protocol login and onboarding components.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dom": {
      "import": {
        "types": "./dist/dom.d.ts",
        "default": "./dist/dom.js"
      },
      "require": {
        "types": "./dist/dom.d.cts",
        "default": "./dist/dom.cjs"
      }
    },
    "./oauth": {
      "import": {
        "types": "./dist/oauth.d.ts",
        "default": "./dist/oauth.js"
      },
      "require": {
        "types": "./dist/oauth.d.cts",
        "default": "./dist/oauth.cjs"
      }
    },
    "./styles.css": "./implementations/typescript/styles.css",
    "./package.json": "./package.json",
    "./contracts/v1/flow.json": "./contracts/v1/flow.json",
    "./contracts/v1/conformance.json": "./contracts/v1/conformance.json",
    "./copy/en.json": "./copy/en.json"
  },
  "files": [
    "dist",
    "implementations/typescript/styles.css",
    "contracts",
    "copy",
    "docs",
    "LICENSE"
  ],
  "sideEffects": [
    "./implementations/typescript/styles.css"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solimaniac/launcher-components.git"
  },
  "homepage": "https://github.com/solimaniac/launcher-components#readme",
  "bugs": "https://github.com/solimaniac/launcher-components/issues",
  "keywords": [
    "atproto",
    "at-protocol",
    "atmosphere",
    "oauth",
    "login",
    "onboarding",
    "components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run generate:contracts && tsup implementations/typescript/src/index.ts implementations/typescript/src/dom.ts implementations/typescript/src/oauth.ts --tsconfig implementations/typescript/tsconfig.json --format esm,cjs --splitting --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run check:contracts && npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "dev": "vite implementations/typescript/examples --host 127.0.0.1",
    "build:examples": "vite build implementations/typescript/examples --base ./ --outDir ../../../example-dist --emptyOutDir",
    "generate:contracts": "node scripts/generate-contract-types.mjs",
    "check:contracts": "node scripts/generate-contract-types.mjs --check"
  },
  "peerDependencies": {
    "@atproto/oauth-client-browser": "^0.5.9"
  },
  "peerDependenciesMeta": {
    "@atproto/oauth-client-browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@atproto/oauth-client-browser": "^0.5.9",
    "@types/node": "^24.19.1",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vite": "^8.3.2"
  }
}
