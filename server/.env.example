PORT=3000
REDIS_URL=redis://127.0.0.1:6379
JETSTREAM_URL=https://jetstream.us-east.bsky.network
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info
IDENTITY_CONCURRENCY=8
# Enable only behind Railway's edge, after verifying X-Real-IP is overwritten.
TRUST_RAILWAY_PROXY=false
RATE_LIMIT_PER_MINUTE=120
GLOBAL_RATE_LIMIT_PER_MINUTE=1200
MAX_CONCURRENT_REQUESTS=32
