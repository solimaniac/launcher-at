# Optional for local development; REQUIRED for a production OAuth deployment.
# Exact HTTPS origin, no trailing slash, path, query, credentials or custom port.
# PUBLIC_ORIGIN=https://your-launcher.example

# Optional activity backend origin (server/), no trailing slash. Unset disables join counts and the
# recent-signups feed. Add the launcher origin to the server's ALLOWED_ORIGINS.
# PUBLIC_ACTIVITY_API=https://server-production-1e48d.up.railway.app
